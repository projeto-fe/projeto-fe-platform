# Supabase (projeto do Instituto, região São Paulo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: envio dos convites por e-mail.
# Sem estas duas, o convite continua sendo criado e aparece como pendente,
# mas nenhum e-mail sai e a tela avisa isso.
RESEND_API_KEY=
# Precisa ser de um domínio verificado no Resend.
EMAIL_REMETENTE="Instituto Projeto Fé <portal@projetofe.org>"

# Endereço público do portal, usado no link do convite.
# Em produção na Vercel isso é preenchido sozinho.
NEXT_PUBLIC_URL_DO_PORTAL=http://localhost:3000

# Gemini: identifica criança, atividade e motivo a partir do texto ditado (ADR 0015).
# Sem esta chave, o ditado continua transcrevendo, só não sugere mais nada, os
# campos ficam sempre em branco para escolha manual.
GEMINI_API_KEY=
